{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-brief.schema.json",
  "title": "Model-neutral workflow brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "purpose",
    "users",
    "entities",
    "screens",
    "actions",
    "states",
    "primaryJourney",
    "surfaces",
    "constraints"
  ],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "purpose": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "purpose": {
            "$ref": "#/$defs/nonEmptyText"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "from", "to"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/nonEmptyText"
          },
          "kind": {
            "enum": ["primary", "secondary", "destructive", "recovery", "utility", "navigation"]
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "primaryJourney": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "enum": ["web", "desktop", "mobile", "slide", "presentation", "pptx"]
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
