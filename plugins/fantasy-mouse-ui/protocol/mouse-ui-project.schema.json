{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mouse-ui-project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "title",
    "characterId",
    "identityAnchors",
    "persona",
    "theme",
    "surfaces",
    "participation",
    "states",
    "rights",
    "qa"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stateDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fantasyRole",
        "expression",
        "pose",
        "handMode",
        "props",
        "bubble",
        "copy"
      ],
      "properties": {
        "fantasyRole": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "pose": {
          "type": "string",
          "minLength": 1
        },
        "handMode": {
          "type": "string",
          "enum": [
            "default-clasped",
            "action"
          ]
        },
        "props": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 256
        },
        "bubble": {
          "type": "string",
          "enum": [
            "auto",
            "show",
            "hide"
          ]
        },
        "copy": {
          "type": "string",
          "minLength": 1
        },
        "faceAssetId": {
          "$ref": "#/$defs/slug"
        },
        "bodyVariantId": {
          "$ref": "#/$defs/slug"
        },
        "motionId": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "faceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "expression",
        "intensity",
        "source",
        "quality",
        "useScope",
        "sourceWidth",
        "sourceHeight",
        "displayWidth"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "intensity": {
          "type": "string",
          "enum": [
            "calm",
            "moderate",
            "strong"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "user-supplied",
            "bundled",
            "generated-approved"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "preview",
            "production"
          ]
        },
        "useScope": {
          "type": "string",
          "enum": [
            "local-project",
            "redistributable"
          ]
        },
        "sourceWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "sourceHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "displayWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          }
        }
      }
    },
    "bodyVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "build",
        "outfit",
        "pose",
        "handMode",
        "attachment",
        "asset",
        "faceFrame"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outfit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "handMode": {
          "type": "string",
          "enum": [
            "default-clasped",
            "action"
          ]
        },
        "attachment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "asset": {
          "$ref": "#/$defs/bodyAsset"
        },
        "faceFrame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1
            }
          }
        }
      }
    },
    "bodyAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "sourceWidth",
        "sourceHeight",
        "source",
        "useScope"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sourceWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "sourceHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "user-supplied",
            "generated",
            "bundled"
          ]
        },
        "useScope": {
          "type": "string",
          "enum": [
            "local-project",
            "redistributable"
          ]
        }
      }
    }
  },
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "characterId": {
      "type": "string",
      "const": "fantasy-mouse-canonical"
    },
    "identityAnchors": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "compact-grey-round-head"
            },
            {
              "type": "string",
              "const": "tiny-horizontal-ears"
            },
            {
              "type": "string",
              "const": "narrowed-vacant-eyes"
            },
            {
              "type": "string",
              "const": "human-like-toothy-grin"
            },
            {
              "type": "string",
              "const": "compact-white-bean-body"
            },
            {
              "type": "string",
              "const": "default-clasped-hands-v-or-u"
            },
            {
              "type": "string",
              "const": "earnest-absurd-dreamer"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "approved-expression-family"
            },
            {
              "type": "string",
              "const": "photographic-face-drawn-body-contrast"
            },
            {
              "type": "string",
              "const": "recognizable-family-proportions"
            },
            {
              "type": "string",
              "const": "one-coherent-hand-pair"
            },
            {
              "type": "string",
              "const": "earnest-absurd-dreamer"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      ]
    },
    "persona": {
      "$ref": "#/$defs/slug",
      "description": "Project-specific character role or temperament derived from the workflow, not a bundled preset."
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Project-specific theme slug derived from the product-style rationale; it is not a bundled preset."
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Open product-specific surface identifiers such as web, desktop, mobile, slide, document, kiosk, or future editable targets.",
      "maxItems": 256
    },
    "participation": {
      "type": "string",
      "enum": [
        "light",
        "standard",
        "immersive"
      ]
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stateDesign"
      },
      "description": "Open state map. Preserve the target product's real state names rather than forcing a bundled state list.",
      "maxProperties": 256
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicExport",
        "assetIds"
      ],
      "properties": {
        "publicExport": {
          "type": "boolean"
        },
        "assetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "maxItems": 256
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual",
        "accessibility",
        "editable"
      ],
      "properties": {
        "visual": {
          "type": "boolean"
        },
        "accessibility": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facePolicy",
        "headPolicy",
        "headReference",
        "faceAssets",
        "bodyVariants",
        "layerOrder"
      ],
      "properties": {
        "facePolicy": {
          "const": "reuse-approved-source"
        },
        "headPolicy": {
          "const": "preserve-source-silhouette",
          "description": "Preserve each selected expression source's own complete natural face outline and features; never impose a common head mask or cover-fit crop."
        },
        "headReference": {
          "$ref": "#/$defs/bodyAsset",
          "description": "Identity reference context, not a universal silhouette stencil for the faceAssets."
        },
        "faceAssets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/faceAsset"
          }
        },
        "bodyVariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/bodyVariant"
          }
        },
        "layerOrder": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "productStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "hierarchy",
        "typography",
        "layout",
        "tokens",
        "responsive",
        "accessibility"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "hierarchy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "typography": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "layout": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tokens": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "responsive": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "states",
          "keyboard",
          "feedback"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "keyboard": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "feedback": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "motion": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trigger",
          "property",
          "durationMs",
          "easing",
          "interrupt",
          "repeat",
          "reducedMotion"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "easing": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "interrupt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repeat": {
            "type": "string",
            "enum": [
              "once",
              "while-pending",
              "none"
            ]
          },
          "reducedMotion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocolVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "identityAnchors": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "const": "compact-grey-round-head"
              },
              {
                "type": "string",
                "const": "tiny-horizontal-ears"
              },
              {
                "type": "string",
                "const": "narrowed-vacant-eyes"
              },
              {
                "type": "string",
                "const": "human-like-toothy-grin"
              },
              {
                "type": "string",
                "const": "compact-white-bean-body"
              },
              {
                "type": "string",
                "const": "default-clasped-hands-v-or-u"
              },
              {
                "type": "string",
                "const": "earnest-absurd-dreamer"
              }
            ],
            "items": false,
            "minItems": 7,
            "maxItems": 7
          },
          "character": false,
          "productStyle": false,
          "components": false,
          "motion": false,
          "states": {
            "additionalProperties": {
              "properties": {
                "faceAssetId": false,
                "bodyVariantId": false,
                "motionId": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocolVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "character",
          "productStyle",
          "components",
          "motion"
        ],
        "properties": {
          "identityAnchors": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "const": "approved-expression-family"
              },
              {
                "type": "string",
                "const": "photographic-face-drawn-body-contrast"
              },
              {
                "type": "string",
                "const": "recognizable-family-proportions"
              },
              {
                "type": "string",
                "const": "one-coherent-hand-pair"
              },
              {
                "type": "string",
                "const": "earnest-absurd-dreamer"
              }
            ],
            "items": false,
            "minItems": 5,
            "maxItems": 5
          },
          "states": {
            "additionalProperties": {
              "required": [
                "faceAssetId",
                "bodyVariantId"
              ]
            }
          }
        }
      }
    }
  ]
}
