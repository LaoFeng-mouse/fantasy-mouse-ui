<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Archive Lantern" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="#F5F3EE" Foreground="#17211D" FontFamily="Segoe UI" FontSize="15"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#17211D" />
    <SolidColorBrush x:Key="Muted" Color="#5A6962" />
    <SolidColorBrush x:Key="Line" Color="#CCD1CA" />
    <SolidColorBrush x:Key="Panel" Color="#FCFBF7" />
    <SolidColorBrush x:Key="Olive" Color="#465D49" />
    <SolidColorBrush x:Key="Amber" Color="#9C6500" />
    <SolidColorBrush x:Key="Danger" Color="#9D302B" />
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="#FCFBF7" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="#8E9A92" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#B76800" />
          <Setter Property="BorderThickness" Value="3" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Olive}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Olive}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#8E9A92" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E1E8E0" />
          <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#B76800" />
          <Setter Property="BorderThickness" Value="3" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="*" />
      <RowDefinition Height="54" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#17211D" Padding="28,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" Background="#D69A31" CornerRadius="6" Margin="0,0,14,0">
            <TextBlock Text="AL" Foreground="#17211D" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="Archive Lantern" Foreground="White" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Local research library" Foreground="#B9C2BC" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Margin="24,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" automation:AutomationProperties.Name="Search archive by title or tag" ToolTip="Search archive by title or tag" />
          <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Margin="8,0,0,0" automation:AutomationProperties.Name="Search archive" />
        </Grid>
        <Button x:Name="FailImportButton" Grid.Column="2" Content="Try damaged sample" Margin="0,0,10,0" ToolTip="Exercise the safe recovery path with an unreadable local sample" automation:AutomationProperties.Name="Import an unreadable sample to test recovery" />
        <Button x:Name="ImportButton" Grid.Column="3" Content="Import files" Style="{StaticResource PrimaryButton}" automation:AutomationProperties.Name="Import archive files" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" MinWidth="500" />
        <ColumnDefinition Width="390" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#E9E6DE" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="20,26">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="8,0,0,12" />
            <Button Content="Library" HorizontalContentAlignment="Left" Margin="0,0,0,8" IsDefault="True" />
            <Button Content="Tags" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
            <Button Content="Recent" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,18,8,0">
              <StackPanel>
                <TextBlock Text="LOCAL ONLY" Foreground="{StaticResource Olive}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Files stay on this device." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#F5F3EE" Padding="30,26">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="WorkspaceTitle" Text="Your archive" FontSize="30" FontWeight="SemiBold" />
              <TextBlock x:Name="WorkspaceSubtitle" Text="Import files to build a searchable local library." Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock x:Name="ResultCount" Grid.Column="1" Text="0 items" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="20,0,0,2" />
          </Grid>

          <Grid Grid.Row="1">
            <ListBox x:Name="ArchiveList" DisplayMemberPath="Title" Background="#FCFBF7" BorderBrush="{StaticResource Line}" BorderThickness="1"
                     automation:AutomationProperties.Name="Archive search results" />

            <Border x:Name="EmptyPanel" Background="#FCFBF7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="46">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="500">
                  <TextBlock Text="Nothing indexed yet" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Import research files to create a private, searchable catalogue on this device." FontSize="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,24" />
                  <Button x:Name="EmptyImportButton" Content="Import your first files" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" automation:AutomationProperties.Name="Import your first archive files" />
                </StackPanel>
                <Image x:Name="EmptyImage" Grid.Column="1" Width="320" Height="320" Stretch="Uniform" automation:AutomationProperties.Name="Mouse librarian waits beside an empty catalogue tray" />
              </Grid>
            </Border>

            <Border x:Name="IndexingPanel" Visibility="Collapsed" Background="#FCFBF7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="42">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image x:Name="IndexingImage" Width="290" Height="290" Stretch="Uniform" automation:AutomationProperties.Name="Mouse index librarian works with a catalogue card" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                  <TextBlock Text="Indexing locally" FontSize="34" FontWeight="SemiBold" />
                  <TextBlock x:Name="IndexingFile" Text="River-Moss-Field-Notes.pdf" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,10,0,24" />
                  <ProgressBar x:Name="IndexProgress" Height="18" Minimum="0" Maximum="100" Value="62" Foreground="{StaticResource Amber}" automation:AutomationProperties.Name="Archive indexing progress" />
                  <TextBlock x:Name="ProgressText" Text="62% · Reading title, notes, and local text" Margin="0,12,0,0" FontWeight="SemiBold" />
                  <TextBlock Text="Your existing library remains available. No files leave this device." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,22,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="RecoveryPanel" Visibility="Collapsed" Background="#FFF9F8" BorderBrush="#C75A50" BorderThickness="2" Padding="40">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image x:Name="RecoveryImage" Width="310" Height="310" Stretch="Uniform" Margin="0,70,0,-70" automation:AutomationProperties.Name="Mouse recovery librarian holds the preserved file card and points to Retry" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="-18,0,0,0">
                  <TextBlock Text="Import paused safely" Foreground="{StaticResource Danger}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="ErrorText" Text="The selected file could not be read. Your library and file selection were preserved." FontSize="18" TextWrapping="Wrap" Margin="0,14,0,18" />
                  <Border Background="#F3E4E1" Padding="14" Margin="0,0,0,22">
                    <TextBlock Text="Unreadable scan · Garden-Ledger-1978.pdf" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                  </Border>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryButton" Content="Retry import" Style="{StaticResource PrimaryButton}" automation:AutomationProperties.Name="Retry failed archive import" />
                    <Button x:Name="CancelRetryButton" Content="Keep library unchanged" Margin="10,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="NoResultsPanel" Visibility="Collapsed" Background="#FCFBF7" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="54">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="No matching archive items" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="NoResultsText" Text="No title or tag matches this query. Revise it or clear search." Foreground="{StaticResource Muted}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,22" />
                <Button x:Name="ClearSearchButton" Content="Clear search" HorizontalAlignment="Center" automation:AutomationProperties.Name="Clear archive search and return to query" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#FCFBF7" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="28,28">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="ITEM DETAILS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="DetailsTitle" Text="Select an item" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="PATH" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
            <TextBlock x:Name="DetailsPath" Text="—" TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="TAGS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
            <WrapPanel x:Name="TagPanel" Margin="0,8,0,20" />
            <TextBlock Text="ADD TAG" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" />
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="TagBox" automation:AutomationProperties.Name="Tag selected archive item" />
              <Button x:Name="AddTagButton" Grid.Column="1" Content="Add" Margin="8,0,0,0" automation:AutomationProperties.Name="Add tag to selected archive item" />
            </Grid>
            <Border x:Name="OpenViewerPanel" Visibility="Collapsed" Background="#EEF2ED" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,26,0,0">
              <StackPanel>
                <TextBlock Text="OPEN LOCALLY" Foreground="{StaticResource Olive}" FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="ViewerText" Text="Preview opened. The original file remains in place." TextWrapping="Wrap" Margin="0,8,0,12" />
                <Button x:Name="BackButton" Content="Back to results" HorizontalAlignment="Left" automation:AutomationProperties.Name="Return to archive search results" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Button x:Name="OpenButton" Grid.Row="2" Content="Open selected item" Style="{StaticResource PrimaryButton}" IsEnabled="False" automation:AutomationProperties.Name="Open selected archive result" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#E9E6DE" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="10" Height="10" Fill="#4B7A55" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Library ready. Import files to begin." VerticalAlignment="Center"
                   automation:AutomationProperties.Name="Archive status" automation:AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="2" Text="Local index · Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
